scope=@platformos

# vite is a non-optional peer of vitest. With legacy-peer-deps, npm omits it and its subtree —
# including the platform-specific rolldown/lightningcss binaries — and writes a lock that CI
# cannot install (`npm ci` fails with "Cannot read properties of null (reading 'edgesOut')" on
# Windows). Set here so a developer's global setting cannot produce that lock.
legacy-peer-deps=false
