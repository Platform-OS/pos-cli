  "devDependencies": {
    "esbuild": "^0.28.2",
    "punycode": "^2.3.1"
  },
  "dependencies": {
    "@graphiql/plugin-explorer": "^5.1.4",
    "assert": "^2.1.0",
    "graphiql": "^5.3.0",
    "graphql": "^15.8.0",
    "graphql-ws": "^6.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
