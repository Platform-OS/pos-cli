{
  "description": "Reminds the agent that platformOS diagnostics must be asked for after a Liquid or GraphQL edit",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
